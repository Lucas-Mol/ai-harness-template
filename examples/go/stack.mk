# Go with gofmt, golangci-lint and go test.
SETUP_CMD          = go mod download
FMT_CMD            = gofmt -w .
FMT_CHECK_CMD      = test -z "$$(gofmt -l .)" || { gofmt -l .; echo "run: make fmt" >&2; exit 1; }
LINT_CMD           = golangci-lint run ./...
TYPECHECK_CMD      = go vet ./... && go build ./...
TEST_CMD           = go test -race ./...
TEST_FAST_CMD      = go test -short ./...
BUILD_CMD          = go build ./...
FMT_FILES_CMD      = gofmt -w
FMT_FILES_PATTERNS = %.go
